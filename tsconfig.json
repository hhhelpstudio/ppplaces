{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUmdGlobalAccess": true,
    "skipLibCheck": true,
    "types": ["google.maps", "leaflet", "sortablejs", "node"]
  },
  "include": ["types/**/*.d.ts", "public/js/**/*.js", "public/js/**/*.d.ts", "test/**/*.js"]
}
